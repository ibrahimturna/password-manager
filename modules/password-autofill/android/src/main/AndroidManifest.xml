<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Without this, Android 11+ hides other apps, so only their package names could be shown. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <application>
    <service
      android:name=".PasswordAutofillService"
      android:exported="true"
      android:label="@string/password_autofill_service_name"
      android:permission="android.permission.BIND_AUTOFILL_SERVICE">
      <intent-filter>
        <action android:name="android.service.autofill.AutofillService" />
      </intent-filter>
      <meta-data
        android:name="android.autofill"
        android:resource="@xml/password_autofill_service" />
    </service>

    <activity
      android:name=".AutofillActivity"
      android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
      android:excludeFromRecents="true"
      android:exported="false"
      android:theme="@style/PasswordAutofillTheme"
      android:windowSoftInputMode="adjustResize" />
  </application>
</manifest>
