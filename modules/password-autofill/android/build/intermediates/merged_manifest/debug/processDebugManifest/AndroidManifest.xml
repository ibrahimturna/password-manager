<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="expo.modules.passwordautofill" >

    <uses-sdk android:minSdkVersion="24" />

    <application>
        <service
            android:name="expo.modules.passwordautofill.PasswordAutofillService"
            android:exported="true"
            android:label="@string/password_autofill_service_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE" >
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>

            <meta-data
                android:name="android.autofill"
                android:resource="@xml/password_autofill_service" />
        </service>

        <activity
            android:name="expo.modules.passwordautofill.AutofillActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/PasswordAutofillTheme"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>